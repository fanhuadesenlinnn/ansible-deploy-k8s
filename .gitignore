# 本地操作系统、环境变量、虚拟环境和 Ansible 临时文件。
.DS_Store
.env
.venv/
*.retry
*.log

# 导出的管理员 kubeconfig 可能授予集群最高权限，绝不能提交。
artifacts/

# 离线包中的真实软件包、镜像、清单和二进制通常体积很大，也可能来自内部环境。
# 仅保留说明文件、目录本身和 .gitkeep 占位符。
files/offline-bundle/*
!files/offline-bundle/README.md
!files/offline-bundle/packages/
!files/offline-bundle/images/
!files/offline-bundle/manifests/
!files/offline-bundle/bin/
files/offline-bundle/packages/*
files/offline-bundle/images/*
files/offline-bundle/manifests/*
files/offline-bundle/bin/*
!files/offline-bundle/packages/.gitkeep
!files/offline-bundle/images/.gitkeep
!files/offline-bundle/manifests/.gitkeep
!files/offline-bundle/bin/.gitkeep

# 只跟踪无敏感信息的 example Inventory；用户复制出的真实环境目录默认忽略。
inventories/*
!inventories/example/
!inventories/example/**
# 即使位于其他 Inventory 路径，也额外忽略常见的逐主机变量和 Vault 文件。
inventories/*/host_vars/
inventories/*/group_vars/vault.yml
