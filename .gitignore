# 本地操作系统、环境变量、虚拟环境和 Ansible 临时文件。
.DS_Store
.env
.venv/
.ansible/
*.retry
*.log

# 导出的管理员 kubeconfig 可能授予集群最高权限，绝不能提交。
ansible/artifacts/

# ops.sh 生成的离线包和归档体积较大，只保留构建脚本，不提交构建结果。
offline/bundles/

# 离线包中的真实软件包、镜像、清单和二进制通常体积很大，也可能来自内部环境。
# 仅保留说明文件、目录本身和 .gitkeep 占位符。
offline/bundle-template/*
!offline/bundle-template/README.md
!offline/bundle-template/packages/
!offline/bundle-template/images/
!offline/bundle-template/manifests/
!offline/bundle-template/bin/
!offline/bundle-template/controller/
offline/bundle-template/packages/*
offline/bundle-template/images/*
offline/bundle-template/manifests/*
offline/bundle-template/bin/*
offline/bundle-template/controller/*
!offline/bundle-template/manifests/addons/
offline/bundle-template/manifests/addons/*
!offline/bundle-template/packages/.gitkeep
!offline/bundle-template/images/.gitkeep
!offline/bundle-template/manifests/.gitkeep
!offline/bundle-template/bin/.gitkeep
!offline/bundle-template/controller/.gitkeep
!offline/bundle-template/manifests/addons/.gitkeep

# 只跟踪无敏感信息的 example Inventory；用户复制出的真实环境目录默认忽略。
ansible/inventories/*
!ansible/inventories/example/
!ansible/inventories/example/**
# 即使位于其他 Inventory 路径，也额外忽略常见的逐主机变量和 Vault 文件。
ansible/inventories/*/host_vars/
ansible/inventories/*/group_vars/vault.yml

# 兼容调整目录前已经生成的本地内容，防止升级后误提交旧 kubeconfig、离线包或真实 Inventory。
/artifacts/
/dist/
files/offline-bundle/
/inventories/
