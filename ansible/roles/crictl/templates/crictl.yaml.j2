---
# crictl 的运行时和镜像操作都连接 kubeadm 使用的同一个 CRI Socket。
# 配置写入 /etc/crictl.yaml 后，管理员可以直接执行 crictl ps、crictl pods 等命令。
runtime-endpoint: "{{ kubernetes_cri_socket }}"
image-endpoint: "{{ kubernetes_cri_socket }}"
# timeout 的单位是秒；debug=true 会输出更详细的请求信息。
timeout: {{ crictl_timeout }}
debug: {{ crictl_debug | bool | lower }}
# pull-image-on-create 控制创建容器时是否主动拉取镜像。
pull-image-on-create: {{ crictl_pull_image_on_create | bool | lower }}
